{
  "source_lang": "ru",
  "locales": [
    "ru",
    "en"
  ],
  "locale_names": {
    "ru": "Русский",
    "en": "English"
  },
  "cues": [
    {
      "once": "map-ready",
      "text": {
        "ru": "Это карта из миллионов экспериментов с двойными маятниками. Попробуйте ее приблизить и рассмотреть подробнее",
        "en": "This is a map of millions of experiments with double pendulums. Try zooming in and examining it more closely"
      },
      "audio": {
        "ru": "audio/ru/map-ready.mp3",
        "en": "audio/en/map-ready.mp3"
      }
    },
    {
      "once": "zoom-in",
      "text": {
        "ru": "Карта приблизилась"
      },
      "audio": {}
    },
    {
      "once": "zoom-out",
      "text": {
        "ru": "Карта отдалилась"
      },
      "audio": {}
    },
    {
      "once": "zoom-reset",
      "text": {
        "ru": "Вид вернулся к целой карте"
      },
      "audio": {}
    },
    {
      "once": "zoom-limit",
      "text": {
        "ru": "Вы дошли до предела симуляции, но карта здесь не заканчивается",
        "en": "You have reached the limit of the simulation, but the map does not end here"
      },
      "audio": {
        "ru": "audio/ru/zoom-limit.mp3",
        "en": "audio/en/zoom-limit.mp3"
      },
      "at_start": [
        {
          "emit": "zoom-in-highlight"
        }
      ],
      "finally": [
        {
          "emit": "zoom-in-unhighlight"
        }
      ]
    },
    {
      "once": "pan",
      "text": {
        "ru": "Карту можно двигать"
      },
      "audio": {}
    },
    {
      "once": "history-back",
      "text": {
        "ru": "Это предыдущий вид"
      },
      "audio": {}
    },
    {
      "once": "menu-open",
      "text": {
        "ru": "Это меню настроек маятника",
        "en": "This is the pendulum settings menu"
      },
      "audio": {
        "ru": "audio/ru/menu-open.mp3",
        "en": "audio/en/menu-open.mp3"
      },
      "at_start": [
        {
          "emit": "settings-panel-highlight"
        }
      ],
      "finally": [
        {
          "emit": "settings-panel-unhighlight"
        }
      ]
    },
    {
      "once": "menu-close",
      "text": {
        "ru": "Меню настроек закрылось"
      },
      "audio": {}
    },
    {
      "once": "param-change",
      "text": {
        "ru": "Параметры маятника изменились"
      },
      "audio": {}
    },
    {
      "once": "budget-change",
      "text": {
        "ru": "Изменился бюджет кадра"
      },
      "audio": {}
    },
    {
      "once": "params-reset",
      "text": {
        "ru": "Параметры сброшены"
      },
      "audio": {}
    },
    {
      "once": "simulation-start",
      "text": {
        "ru": "Симуляция запущена"
      },
      "audio": {}
    },
    {
      "once": "probe-detach",
      "text": {
        "ru": "У маятника нет трения. Если он раскручивается слишком быстро, то срывается с оси",
        "en": "The pendulum has no friction. If it spins too fast, it breaks off the axis"
      },
      "audio": {
        "ru": "audio/ru/probe-detach.mp3",
        "en": "audio/en/probe-detach.mp3"
      }
    },
    {
      "once": "pendulum-hang",
      "text": {
        "ru": "Больше половины маятников уже не висят на оси"
      },
      "audio": {}
    },
    {
      "once": "probe-end",
      "text": {
        "ru": "Симуляция закончилась"
      },
      "audio": {}
    },
    {
      "once": "close-up",
      "when": {
        "zoom_deg": 45
      },
      "text": {
        "ru": "На самой длинной стороне экрана около 45 градусов"
      },
      "audio": {}
    },
    {
      "once": "still-running",
      "when": {
        "simulation_sec": 5
      },
      "text": {
        "ru": "Симуляция идёт уже пять секунд"
      },
      "audio": {}
    },
    {
      "once": "still-here",
      "when": {
        "page_sec": 20
      },
      "text": {
        "ru": "Вы уже двадцать секунд на странице"
      },
      "audio": {}
    }
  ]
}
