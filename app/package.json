{
  "name": "fractal-explorer-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build:wasm": "wasm-pack build crates/map_core --target web --out-dir ../../src/maps/pendulum/pkg --release",
    "dev": "npm run build:wasm && vite",
    "build": "npm run build:wasm && tsc --noEmit && vite build",
    "narrate": "narration sync --dir ../narration",
    "narrate:source": "narration sync --dir ../narration --source-only"
  },
  "dependencies": {
    "@nebelmesser/narration": "file:../../narration"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.72",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vite-plugin-wasm": "^3.5.0"
  }
}
